@prefix : <http://portsmith.example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Category class hierarchy -- real rows from Chapter 12's categories table
:Category_all_categories a rdfs:Class ; rdfs:label "All Categories" .
:Category_restaurant a rdfs:Class ; rdfs:label "restaurant" ; rdfs:subClassOf :Category_all_categories .
:Category_seafood a rdfs:Class ; rdfs:label "seafood" ; rdfs:subClassOf :Category_restaurant .
:Category_pub a rdfs:Class ; rdfs:label "pub" ; rdfs:subClassOf :Category_restaurant .
:Category_italian a rdfs:Class ; rdfs:label "italian" ; rdfs:subClassOf :Category_restaurant .
:Category_french a rdfs:Class ; rdfs:label "french" ; rdfs:subClassOf :Category_restaurant .
:Category_chinese a rdfs:Class ; rdfs:label "chinese" ; rdfs:subClassOf :Category_restaurant .
:Category_indian a rdfs:Class ; rdfs:label "indian" ; rdfs:subClassOf :Category_restaurant .
:Category_mexican a rdfs:Class ; rdfs:label "mexican" ; rdfs:subClassOf :Category_restaurant .
:Category_caribbean a rdfs:Class ; rdfs:label "caribbean" ; rdfs:subClassOf :Category_restaurant .
:Category_thai a rdfs:Class ; rdfs:label "thai" ; rdfs:subClassOf :Category_restaurant .
:Category_vegan a rdfs:Class ; rdfs:label "vegan" ; rdfs:subClassOf :Category_restaurant .
:Category_deli a rdfs:Class ; rdfs:label "deli" ; rdfs:subClassOf :Category_restaurant .
:Category_bakery a rdfs:Class ; rdfs:label "bakery" ; rdfs:subClassOf :Category_restaurant .
:Category_american a rdfs:Class ; rdfs:label "american" ; rdfs:subClassOf :Category_restaurant .
:Category_british a rdfs:Class ; rdfs:label "british" ; rdfs:subClassOf :Category_restaurant .
:Category_retail a rdfs:Class ; rdfs:label "retail" ; rdfs:subClassOf :Category_all_categories .
:Category_specialty_food a rdfs:Class ; rdfs:label "specialty_food" ; rdfs:subClassOf :Category_retail .
:Category_bookshop a rdfs:Class ; rdfs:label "bookshop" ; rdfs:subClassOf :Category_retail .
:Category_sporting_goods a rdfs:Class ; rdfs:label "sporting_goods" ; rdfs:subClassOf :Category_retail .
:Category_gallery a rdfs:Class ; rdfs:label "gallery" ; rdfs:subClassOf :Category_retail .
:Category_hardware a rdfs:Class ; rdfs:label "hardware" ; rdfs:subClassOf :Category_retail .
:Category_grocery a rdfs:Class ; rdfs:label "grocery" ; rdfs:subClassOf :Category_retail .
:Category_electronics a rdfs:Class ; rdfs:label "electronics" ; rdfs:subClassOf :Category_retail .
:Category_pharmacy a rdfs:Class ; rdfs:label "pharmacy" ; rdfs:subClassOf :Category_retail .
:Category_marine_hardware a rdfs:Class ; rdfs:label "marine_hardware" ; rdfs:subClassOf :Category_retail .
:Category_art_supplies a rdfs:Class ; rdfs:label "art_supplies" ; rdfs:subClassOf :Category_retail .
:Category_service a rdfs:Class ; rdfs:label "service" ; rdfs:subClassOf :Category_all_categories .
:Category_barber a rdfs:Class ; rdfs:label "barber" ; rdfs:subClassOf :Category_service .
:Category_legal a rdfs:Class ; rdfs:label "legal" ; rdfs:subClassOf :Category_service .
:Category_accountant a rdfs:Class ; rdfs:label "accountant" ; rdfs:subClassOf :Category_service .
:Category_tailor a rdfs:Class ; rdfs:label "tailor" ; rdfs:subClassOf :Category_service .
:Category_auto_repair a rdfs:Class ; rdfs:label "auto_repair" ; rdfs:subClassOf :Category_service .
:Category_spa a rdfs:Class ; rdfs:label "spa" ; rdfs:subClassOf :Category_service .
:Category_dentist a rdfs:Class ; rdfs:label "dentist" ; rdfs:subClassOf :Category_service .
:Category_veterinarian a rdfs:Class ; rdfs:label "veterinarian" ; rdfs:subClassOf :Category_service .
:Category_plumber a rdfs:Class ; rdfs:label "plumber" ; rdfs:subClassOf :Category_service .
:Category_accommodation a rdfs:Class ; rdfs:label "accommodation" ; rdfs:subClassOf :Category_all_categories .
:Category_inn a rdfs:Class ; rdfs:label "inn" ; rdfs:subClassOf :Category_accommodation .
:Category_bed_and_breakfast a rdfs:Class ; rdfs:label "bed_and_breakfast" ; rdfs:subClassOf :Category_accommodation .
:Category_hotel a rdfs:Class ; rdfs:label "hotel" ; rdfs:subClassOf :Category_accommodation .
:Category_hostel a rdfs:Class ; rdfs:label "hostel" ; rdfs:subClassOf :Category_accommodation .
:Category_entertainment a rdfs:Class ; rdfs:label "entertainment" ; rdfs:subClassOf :Category_all_categories .
:Category_theater a rdfs:Class ; rdfs:label "theater" ; rdfs:subClassOf :Category_entertainment .
:Category_pub a rdfs:Class ; rdfs:label "pub" ; rdfs:subClassOf :Category_entertainment .
:Category_live_music a rdfs:Class ; rdfs:label "live_music" ; rdfs:subClassOf :Category_entertainment .
:Category_cinema a rdfs:Class ; rdfs:label "cinema" ; rdfs:subClassOf :Category_entertainment .
:Category_bar a rdfs:Class ; rdfs:label "bar" ; rdfs:subClassOf :Category_entertainment .

