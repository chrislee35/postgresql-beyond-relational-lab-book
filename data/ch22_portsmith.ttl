@prefix : <http://portsmith.example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:portsmith a :City ; rdfs:label "Portsmith" .

# Neighborhoods -- real rows from Chapter 2's neighborhoods table
:harbour_district a :Neighborhood ; rdfs:label "Harbour District" ; :population 4200 ; :partOf :portsmith .
:old_town a :Neighborhood ; rdfs:label "Old Town" ; :population 6800 ; :partOf :portsmith .
:northgate a :Neighborhood ; rdfs:label "Northgate" ; :population 18500 ; :partOf :portsmith .
:riverside a :Neighborhood ; rdfs:label "Riverside" ; :population 9300 ; :partOf :portsmith .
:university_quarter a :Neighborhood ; rdfs:label "University Quarter" ; :population 11200 ; :partOf :portsmith .
:industrial_port a :Neighborhood ; rdfs:label "Industrial Port" ; :population 2100 ; :partOf :portsmith .

# Adjacency -- real ST_Touches results against Chapter 2's polygons, one direction per touching pair
:harbour_district :adjacentTo :industrial_port .
:harbour_district :adjacentTo :old_town .
:harbour_district :adjacentTo :riverside .
:harbour_district :adjacentTo :university_quarter .
:northgate :adjacentTo :riverside .
:northgate :adjacentTo :university_quarter .
:old_town :adjacentTo :northgate .
:old_town :adjacentTo :riverside .
:old_town :adjacentTo :university_quarter .
:riverside :adjacentTo :industrial_port .

